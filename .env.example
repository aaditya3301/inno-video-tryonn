# Decart API keys — get them at https://platform.decart.ai
# Used only on the server (app/api/token/route.ts); they are never sent to the browser.
#
# Easiest: put one key per line in keys.csv in the project root (see keys.example.csv).
# The app rotates to the next key when one runs out of credits.
# On hosts without a keys.csv (e.g. Vercel), list them here instead, comma-separated:
DECART_API_KEYS=
# A single key still works too:
DECART_API_KEY=

# Credits on each key. Lucy 2.5 fast mode bills 4 credits/sec, so 1000 credits
# is about 250 seconds. Only used for the on-screen countdown until the app has
# seen a key actually run out.
CREDITS_PER_KEY=1000
