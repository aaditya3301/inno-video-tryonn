# Decart API keys — get them at https://platform.decart.ai
# Used only on the server (app/api/token/route.ts); they are never sent to the browser.
#
# Easiest: put one key per line in keys.csv in the project root (see keys.example.csv).
# The app rotates to the next key when one runs out of credits.
# On hosts without a keys.csv (e.g. Vercel), list them here instead, comma-separated:
DECART_API_KEYS=
# A single key still works too:
DECART_API_KEY=

# Credits on each key. The try-on model in fast mode bills 4 credits/sec, so 1000
# credits is about 250 seconds. Only used for the on-screen countdown until the app has
# seen a key actually run out.
CREDITS_PER_KEY=1000

# Google Cloud only: name of the Secret Manager secret that holds the keys. When set,
# the app reads the newest version at runtime (so key changes need no redeploy) and
# /billing removes empty keys by saving a new version of it. Leave empty elsewhere.
KEYS_SECRET=

# Password for the "Add a key" dialog on /billing. Leave empty and anyone with the link
# can add keys. On Google Cloud, inject it from a secret instead of writing it here.
BILLING_PASSWORD=

# /billing removes keys with fewer credits than this (default 1: only keys at zero).
# 4 would also remove keys that can't pay for a single second.
REMOVE_BELOW_CREDITS=1
